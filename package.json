{
  "name": "dsh-ygritte-boot",
  "version": "1.3.1",
  "type": "module",
  "description": "Full-screen ice-and-fire boot intro + Ygritte identity authorization for DeepSeek Harness (DSH): a host-injected first frame, typed bilingual boot log, five-step identity verification, Esc to skip, and a settings page with off/quick/full modes.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "preview",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && npm run check"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ygritteee/dsh-ygritte-boot.git"
  },
  "homepage": "https://github.com/Ygritteee/dsh-ygritte-boot#readme",
  "bugs": {
    "url": "https://github.com/Ygritteee/dsh-ygritte-boot/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-boot",
    "boot-animation",
    "splash",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Ygritteee"
  }
}
